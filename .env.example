# ============================================================
# 交付配置：客户只需要填下面 1-2 个值，其余全部由 bootstrap 自动创建
# 用法：把本文件复制为仓库根 .env（bootstrap 首次运行也会自动复制）
# ⚠️ .env 已被 .gitignore 忽略，真实 Key 永远不要提交进 Git
# ============================================================

# 讯飞 Spark（LLM）API Key —— 简历解析 / AI 评分必需
LLM_API_KEY=

# 阿里百炼（Embedding）API Key —— 向量检索 / 语义匹配必需
# 留空时沿用 LLM 供应商占位配置，向量功能不可用但不影响环境创建
EMBEDDING_API_KEY=

# ------------------------------------------------------------
# 以下均为可选项，一般不用改；写上即覆盖 backend/.env.example 的默认值
# ------------------------------------------------------------
# LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# LLM_MODEL=spark-x2.6
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=aitalent_2026
# MYSQL_DB=ai_talent
# MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=talent_vectors
# APP_PORT=8000
# FRONTEND_PORT=3000

# ------------------------------------------------------------
# 端口冲突 / 多套环境并存时才需要（默认全部注释，保持 3306/19530）
# 例：本机 3306 或 19530 已被别的项目占用，改用下面这组隔离值
# ------------------------------------------------------------
# MYSQL_PORT=3307
# MILVUS_PORT=19531
# MILVUS_METRICS_PORT=9092      # 不填则随 MILVUS_PORT 自动联动
# COMPOSE_PROJECT_NAME=aitalent_e2e   # 容器名/卷名前缀，避免撞已有容器
# MILVUS_COLLECTION=talent_vectors_e2e  # 隔离 collection，避免碰已有向量数据
# ANALYTICS_PG_PORT=5433      # T-D02 分析副本 PG（docker compose -f deploy/postgres/... up -d）
# REDIS_PORT=6399             # T-D01 可选 Redis（未配置 REDIS_URL 时缓存/限流全降级）
