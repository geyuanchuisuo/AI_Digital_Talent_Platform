# ===== LLM / Embedding =====
# 本文件是「默认值模板」，不是可直接运行的配置。
# 一键交付：scripts/A/bootstrap.py 会读取本模板 + 仓库根 .env，自动生成 backend/.env
#（随机 JWT_SECRET、MySQL 密码、前后端地址），客户只需在根 .env 填模型 Key。
#
# 【模型双模式（2026-11-11 用户确认）】生产环境预留「云 API」与「本地推理」两种接入，
# 客户按自身需求选择；两者均为 OpenAI 兼容协议，切换=改 .env，业务代码零改动。
#
# —— 方式 A：云 API 模式（演示/验收默认，历史实配）——
#    LLM=讯飞 spark-x2.6、Embedding=阿里百炼 text-embedding-v3（决策 D-L），允许不同供应商。
LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
LLM_API_KEY=sk-your-llm-key-here
LLM_MODEL=spark-x2.6
LLM_TIMEOUT=120
LLM_CONCURRENCY=2

# —— 方式 B：本地推理模式（私有化/离线交付）——
# LLM 指向本地 OpenAI 兼容网关（Ollama / vLLM / llama.cpp server / one-api 均可）：
#   例：OLLAMA：
#     LLM_BASE_URL=http://127.0.0.1:11434/v1
#     LLM_API_KEY=ollama            # Ollama 不校验 key，填任意非空串
#     LLM_MODEL=qwen2.5:14b         # ollama pull 的模型名
#   例：one-api / new-api 聚合网关（多上游统一 key）：
#     LLM_BASE_URL=http://127.0.0.1:20128/v1
#     LLM_API_KEY=sk-xxxx
#     LLM_MODEL=<网关内模型名>
# 本地 Embedding（RERANK/EMBEDDING 段的 local 模式，见下）。

# ===== Embedding 双模式 =====
# API 模式（默认）：百炼 text-embedding-v3（1024 维）
EMBEDDING_MODE=api
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_MODEL=text-embedding-v3
# 本地模式（离线/私有化）：sentence_transformers 加载客户本地模型目录（不进 Git）。
# 推荐 BAAI/bge-large-zh-v1.5——1024 维与 Milvus collection 冻结维度一致，切换无需重建集合。
#   1) backend/.venv/Scripts/pip install sentence-transformers
#   2) EMBEDDING_MODE=local + 模型目录（含 config.json 的那一层）：
# EMBEDDING_MODE=local
# EMBEDDING_LOCAL_MODEL_PATH=E:/AI_sentence_transformers/models/BAAI--bge-large-zh-v1.5/snapshots/master
# EMBEDDING_LOCAL_DEVICE=cpu          # 有 GPU 可填 cuda
EMBEDDING_QUERY_CACHE_TTL=300
EMBEDDING_TIMEOUT=10
VECTOR_SYNC_TIMEOUT=5  # 原默认 1.5；H-14 实测冷连接 embedding ~1.7s，2026-11-06 批准上调（运行配置 v1.4）
PROMPT_VERSION=v1.0
EMBEDDING_DIM=1024

# ===== 重排双模式（PRD D22；一期必备，检索召回后精排）=====
# off（默认）= 不重排，召回序原样返回（行为与未启用前一致）；api / local 二选一。
RERANK_MODE=off
# API 模式：百炼 gte-rerank（与 Embedding 同供应商体系；空则回退 EMBEDDING_* 配置）。
#RERANK_MODE=api
#RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#RERANK_API_KEY=sk-your-embedding-key-here
#RERANK_MODEL=gte-rerank
#RERANK_TIMEOUT=10
# 本地模式：bge-reranker-base（XLMRoberta 分类头，CPU 可跑 ~1.1GB；模型目录客户本地提供）。
#   前置同上：pip install sentence-transformers
#RERANK_MODE=local
#RERANK_LOCAL_MODEL_PATH=E:/AI_sentence_transformers/models/BAAI--bge-reranker-base
#RERANK_LOCAL_DEVICE=cpu
# ⚠️ api 与 local 两种模式的分制不可跨模式比较，分数只用于同一次召回内排序。

# ===== Dify 运行追踪回写（T-D16，可选；留空=不回写，零副作用）=====
# 终态工作流运行 POST 到该 URL（schema ait.dify.run-trace.v1）；失败只记日志不阻塞业务。
#DIFY_RUN_TRACE_URL=

# ===== D25 智能解读 LLM 增强（默认关；规则解读打底，LLM 仅增补推断段）=====
# 开启前提：LLM 段已配置可用模型（API 模式或本地网关）；因果措辞/无依据增补段自动丢弃，
# LLM 不可用时如实回退 generator="rule"，不阻塞指标查询。
#ANALYTICS_LLM_INSIGHT_ENABLED=false

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=aitalent_2026
MYSQL_DB=ai_talent

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=talent_vectors

# ===== JWT =====
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRE_HOURS=24

# ===== 上传 =====
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=20
UPLOAD_ALLOWED_EXT=pdf,docx

# ===== TaskRunner =====
TASK_CONCURRENCY=2
RUNNER_SCAN_INTERVAL=2.0
TASK_HEARTBEAT_TIMEOUT=600
TASK_SHUTDOWN_TIMEOUT=30

# ===== 应用 =====
CORS_ORIGINS=*
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_ECHO=false
EMBEDDING_DIM=1024

# ---- OCR / PDF 页渲染（REQ-B-20261106-01，默认关闭；开启后建议 upload_allowed_ext 加 png,jpg,jpeg）----
OCR_ENABLED=false
# 模型文件目录（rapidocr 首次运行会下载到该目录；目录属运行数据，不进 Git）
OCR_MODEL_DIR=./data/models/ocr
OCR_MAX_PAGE_PIXELS=2000000
OCR_MAX_PAGES=50
OCR_TIMEOUT_SECONDS=120

# ---- Redis 缓存/限流（T-D01，可选；留空=全降级直查库，应用行为不变）----
# 本机测试用：docker run -d --name aitalent-test-redis -p 6399:6379 redis:7-alpine
#REDIS_URL=redis://localhost:6379/0
#RATE_LIMIT_PER_MINUTE=120
#RATE_LIMIT_WINDOW_SECONDS=60
#RATE_LIMIT_BLACKLIST_TTL=3600
# ---- D02 限流环境开关（Master 统一执行表，A 侧 2026-11-10 交付）----
# 默认 false：演示/验收环境全量豁免 /api，避免共享 Redis 的
# aitalent:ratelimit:blacklist:{ip} 键跨环境串扰（会把别的环境打成 403）。
# 客户部署启用：置 true，并为**每个环境**指定独占 Redis 实例或独立 DB 号
# （REDIS_URL 末尾 /N，例如 redis://localhost:6379/3）；此时只豁免 /api/health，
# 固定窗口 429 / 黑名单 403 / Redis 故障降级放行才真正生效。
#RATE_LIMIT_ENABLED=false

# ---- PostgreSQL 只读分析副本（T-D02，可选；留空=问数/报表降级主库直查）----
# 容器：docker compose -f deploy/postgres/docker-compose.yml up -d（映射 5433）
#ANALYTICS_DB_URL=postgresql+psycopg://postgres:aitalent_2026@localhost:5433/ai_talent_analytics
