# ===== LLM / Embedding =====
# ⚠️ 以下为占位示例。本项目实际配置（决策 D-L，见开发日志 Layer 5）：
#    LLM=讯飞 spark-x2.6（maas-api.cn-huabei-1.xf-yun.com/v2）
#    Embedding=阿里百炼 text-embedding-v3（dashscope.aliyuncs.com/compatible-mode/v1）
#    两者允许不同供应商，均为 OpenAI 兼容协议。以 backend/.env 实配为准，勿照抄本示例覆盖。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-llm-key-here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_CONCURRENCY=2

EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_QUERY_CACHE_TTL=300
EMBEDDING_TIMEOUT=10
VECTOR_SYNC_TIMEOUT=5  # 原默认 1.5；H-14 实测冷连接 embedding ~1.7s，2026-11-06 批准上调（运行配置 v1.4）
PROMPT_VERSION=v1.0

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=ai_talent

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=talent_vectors

# ===== JWT =====
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRE_HOURS=24

# ===== 上传 =====
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=20
UPLOAD_ALLOWED_EXT=pdf,docx

# ===== TaskRunner =====
TASK_CONCURRENCY=2
RUNNER_SCAN_INTERVAL=2.0
TASK_HEARTBEAT_TIMEOUT=600
TASK_SHUTDOWN_TIMEOUT=30

# ===== 应用 =====
CORS_ORIGINS=*
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_ECHO=false
EMBEDDING_DIM=1024
